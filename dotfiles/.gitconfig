[user]
	name = GabrielCosme
	email = cosmebarbosa.gabriel@gmail.com

[init]
	defaultBranch = main

[push]
	# No more "git push --set-upstream origin <branch>" on a new branch.
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[fetch]
	prune = true
	pruneTags = true

[rebase]
	# Stash dirty work automatically instead of refusing to rebase.
	autoStash = true
	autoSquash = true
	updateRefs = true

[merge]
	# zdiff3 shows the common ancestor in conflicts, which makes them far
	# easier to resolve than the default two-sided view.
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
	renames = true

[rerere]
	# Remember how a conflict was resolved and replay it next time.
	enabled = true
	autoUpdate = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[column]
	ui = auto

[log]
	date = iso

[help]
	autocorrect = prompt

[core]
	excludesfile = ~/.gitignore_global
	# WSL works on the Linux filesystem: normalise CRLF on commit, never on checkout.
	autocrlf = input

[commit]
	verbose = true

[transfer]
	fsckobjects = true

# No [alias] section on purpose: the oh-my-zsh `git` plugin already provides
# shell-level shortcuts (gst, gco, glog, ...), and git aliases would duplicate it.
